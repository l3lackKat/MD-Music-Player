{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDMusic",
  "version": "0.1.0",
  "identifier": "com.mdmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDMusic",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 540,
        "backgroundColor": "#0d0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: cover: http://cover.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
